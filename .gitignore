# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Figures regenerated by the scripts (the released PNG/PDF/XLSX are tracked,
# but a local re-run writes its output here too)
model/*.log
results/*.log

# results/ tracks DATA tables only (.xlsx / .csv).  A local re-run with
# BECCS_OUT_DIR=../results also writes its figure renders there; those are
# duplicates of figures/ and are not tracked.
results/*.png
results/*.pdf

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp
